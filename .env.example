# Copy this file to ".env" and fill in real values. NEVER commit the real .env.

# ---------------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------------
# The URL residents reach. This string is baked into every printed QR code, so
# decide it BEFORE running "npm run qr". Changing it later means reprinting all
# 35 signs.
# Local testing:  http://localhost:8080
# Live:           https://service.300miamicondo.com
PUBLIC_BASE_URL=http://localhost:8080

# Port the application listens on. The reverse proxy forwards to this.
PORT=8080

# Interface to bind. Leave as loopback when the reverse proxy is on the same
# host -- that keeps the plain-HTTP service unreachable from the network.
# Set 0.0.0.0 only inside a container, or when the proxy is on another host.
BIND_HOST=127.0.0.1

# Where the SQLite database lives. THIS IS THE PATH TO BACK UP -- it holds the
# QR tokens, and losing it means reprinting every sign in the building.
# Leave blank to use ./data next to the application.
DATA_DIR=

# Where generated QR images and sign sheets are written. Blank = ./signs
SIGNS_DIR=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Signs the MARK SERVICED links and the dashboard session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every outstanding MARK SERVICED link and logs the
# dashboard out. It does NOT affect the printed QR codes.
SECRET=

# Passcode for the /ops dashboard. Anything you can share with management.
OPS_PASSCODE=

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
# Where service requests are emailed. A distribution address is best so the
# whole team sees it, not one person's inbox.
#
# Cleaning and resupply requests go to HOUSEKEEPING_EMAIL.
# "Something is broken" goes to ENGINEERING_EMAIL.
# Leave ENGINEERING_EMAIL blank to send everything to housekeeping.
HOUSEKEEPING_EMAIL=housekeeping@300miamicondo.com
ENGINEERING_EMAIL=engineering@300miamicondo.com

# Copied on every request. Leave blank for none.
DISPATCH_CC=operations@300miamicondo.com

# Minutes a location stays suppressed after being reported, so one dirty
# elevator does not generate 15 emails. An OPEN request always suppresses,
# regardless of this value.
SUPPRESSION_MINUTES=30

# ---------------------------------------------------------------------------
# Escalation, weekly digest, monthly backup
# ---------------------------------------------------------------------------
# One address that receives everything that is not a dispatch: the 60-minute
# escalation, the Monday digest, and the monthly database backup. Each can be
# overridden individually below. Blank falls back to DISPATCH_CC.
MANAGER_EMAIL=operations@300miamicondo.com

# A request still open after this many minutes nudges ESCALATE_TO (blank =
# DISPATCH_CC, i.e. the front desk). Still open after the second threshold, it
# nudges ESCALATE_AGAIN_TO (blank = MANAGER_EMAIL). Set a threshold to 0 to
# disable that level.
ESCALATE_AFTER_MINUTES=30
ESCALATE_TO=
ESCALATE_AGAIN_AFTER_MINUTES=60
ESCALATE_AGAIN_TO=

# Weekly summary: requests, response times, re-scans, by location and team.
# DIGEST_DAY is 0 Sunday .. 6 Saturday; DIGEST_HOUR is local building time.
DIGEST_TO=
DIGEST_DAY=1
DIGEST_HOUR=7

# The database file, emailed as an attachment. This is the copy that lets you
# reprint every sign if the server is ever lost -- keep the emails.
BACKUP_TO=
BACKUP_DAY=1
BACKUP_HOUR=6

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Two ways to send. Leave both unconfigured to run in console mode: requests
# are logged and stored but nothing is emailed.
#
#   resend  Recommended. Sends over HTTPS from a domain you control. No
#           password to expire, and unaffected by Microsoft retiring basic
#           auth for SMTP AUTH at the end of 2026.
#   smtp    Microsoft 365 mailbox + app password. Works today, has a deadline.
#
# Blank picks resend when RESEND_API_KEY is set, otherwise smtp.
EMAIL_PROVIDER=

# --- Resend --------------------------------------------------------------
# Key from resend.com -> API Keys. Starts "re_".
RESEND_API_KEY=

# Must be on a domain verified in Resend. A display name is allowed and makes
# the email look like it belongs to the building rather than to a robot.
RESEND_FROM="AMR Service Requests <notifications@amrservices300.com>"

# Where a staff reply goes. The sending address is a notification identity, so
# without this a reply disappears. Set up Cloudflare Email Routing to forward
# notifications@amrservices300.com here as well.
REPLY_TO=operations@300miamicondo.com

# --- Microsoft 365 SMTP (alternative) ------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Safety switch
# ---------------------------------------------------------------------------
# true  = log requests, never send email (pilot rehearsal)
# false = live, housekeeping gets emailed
DRY_RUN=true
